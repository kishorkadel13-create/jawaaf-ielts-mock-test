# Server Configurations
PORT=5000
HOST=127.0.0.1
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: override public audio base URL, useful when moving audio behind a CDN.
# Defaults to SUPABASE_URL/storage/v1/object/public/ielts-assets
AUDIO_BASE_URL=

# Max upload size in MB. Keep this <= Supabase Storage global/bucket limit.
# Supabase Free projects cannot exceed 50MB.
UPLOAD_MAX_SIZE_MB=50

# Authentication
JWT_SECRET=your-custom-jwt-secret-key-for-backend-verification
