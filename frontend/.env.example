# API Configurations
VITE_API_URL=/api
VITE_BACKEND_URL=http://127.0.0.1:5001
VITE_APP_URL=http://localhost:5173

# Supabase Credentials
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Optional: override public audio base URL, useful when moving audio behind a CDN.
# Defaults to VITE_SUPABASE_URL/storage/v1/object/public/ielts-assets
VITE_AUDIO_BASE_URL=

# Max browser-side upload size in MB. Keep this <= Supabase Storage global/bucket limit.
# Supabase Free projects cannot exceed 50MB.
VITE_UPLOAD_MAX_SIZE_MB=50
